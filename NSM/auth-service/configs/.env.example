# Copy to .env for local development. Only the two secrets below are
# required — everything else falls back to configs/config.yaml's
# defaults (see that file's comment for why the split exists).
# Never commit a real .env — see the root .gitignore.
#
# Env vars follow AUTH_<SECTION>_<FIELD>, uppercased, matching
# internal/config.Config's mapstructure tags exactly — e.g. the struct
# field Config.JWT.SigningKey (`jwt.signing_key`) is AUTH_JWT_SIGNING_KEY.

# Must be at least 32 characters — see Config.Validate. Generate one with:
# openssl rand -base64 32
AUTH_JWT_SIGNING_KEY=change-me-to-a-real-random-32-byte-secret

# Required outside development — see Config.Validate.
AUTH_DATABASE_PASSWORD=devpassword

# --- everything below overrides a configs/config.yaml default; only ---
# --- uncomment what you actually need to change locally ---

# AUTH_ENVIRONMENT=development
# AUTH_SERVER_HTTP_ADDR=:8080
# AUTH_SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AUTH_DATABASE_URL=postgres://authsvc:devpassword@localhost:5432/authdb?sslmode=disable
# AUTH_DATABASE_HOST=localhost
# AUTH_DATABASE_PORT=5432
# AUTH_DATABASE_USER=authsvc
# AUTH_DATABASE_NAME=authdb

# AUTH_JWT_ACCESS_TOKEN_TTL=15m
# AUTH_JWT_REFRESH_TOKEN_TTL=720h

# AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=5
# AUTH_LOG_LEVEL=debug
